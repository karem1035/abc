# Postgres
POSTGRES_USER=abc
POSTGRES_PASSWORD=abc
POSTGRES_DB=abc
DATABASE_URL=postgres://abc:abc@localhost:5432/abc

# CORS (comma-separated origins; empty allows none with credentials)
CORS_ORIGINS=http://localhost:5173

# RustFS / S3
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=abc-public
# Public base URL the browser uses to fetch files (no trailing slash)
RUSTFS_PUBLIC_URL=http://localhost:9000/abc-public

# Auth
JWT_SECRET=dev-change-me-please-use-at-least-32-chars
JWT_EXPIRES_IN=8h
PORT=3000

# Seed (defaults to 0000)
SEED_ADMIN_PASSWORD=0000
SEED_CALL_CENTER_PASSWORD=0000
SEED_MARKETER_PASSWORD=0000
