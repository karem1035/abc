# Postgres
POSTGRES_USER=abc
POSTGRES_PASSWORD=abc
POSTGRES_DB=abc
DATABASE_URL=postgres://abc:abc@localhost:5432/abc

# CORS (comma-separated origins; empty allows none with credentials)
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=dev-change-me-please-use-at-least-32-chars
JWT_EXPIRES_IN=8h
PORT=3000

# Seed (defaults to 0000)
SEED_ADMIN_PASSWORD=0000
SEED_CALL_CENTER_PASSWORD=0000
SEED_MARKETER_PASSWORD=0000
